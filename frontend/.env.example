# Frontend Environment Variables
VITE_APP_NAME=Tazama Case Management System
VITE_APP_VERSION=0.0.1
VITE_CRYPTO_KEY=

# Backend origin the SPA calls directly.
VITE_API_BASE_URL=http://localhost:3090

# Optional dev proxy (see vite.config.ts). If set, VITE_API_BASE_URL must be
# this dev server's own URL (e.g. http://localhost:5175), not the backend's -
# otherwise requests bypass the proxy entirely.
# VITE_API_BASE_URL=http://localhost:5175
# VITE_DEV_PROXY_TARGET=http://localhost:3090
