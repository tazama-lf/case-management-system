#System
NODE_ENV=dev
MAX_CPU=1
PORT=3090

#Database
POSTGRES_DB=tazama_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=unused
POSTGRES_HOST=tazama-postgres-1
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:unused@tazama-postgres-1:5432/tazama_cms"
DWH_DATABASE_URL="postgresql://postgres:unused@tazama-postgres-1:5432/tazama_dwh"
#Alert Triage
TRIAGE_TYPE=MANUAL
CONFIDENCE_THRESHOLD=95
CLIENT_SYSTEM_INTERDICTION_ENABLED=true
SYSTEM_UUID=a9a8ff94-c7e4-4e6c-b421-e6d5d75a76e1

#Auth
TAZAMA_AUTH_URL=http://10.10.80.30:3020/v1/auth
AUTH_PUBLIC_KEY_PATH=public.pem
CERT_PATH_PUBLIC=public.pem

# Flowable Configuration
FLOWABLE_URL=http://tazama-cms-flowable:8080/flowable-rest
FLOWABLE_USERNAME=rest-admin
FLOWABLE_PASSWORD=test

SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:postgresql://tazama-postgres-1:5432/flowable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=unused

# NATS Server
SERVER_URL=nats://nats:4222
STARTUP_TYPE=nats
FUNCTION_NAME=case-management-service
PRODUCER_STREAM=default
CONSUMER_STREAM=investigation-service

# Performance
#SIDECAR_HOST=0.0.0.0:5000

# Redis
REDIS_HOST=tazama-valkey-1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0



# Auto-assignment (disabled for MVP)
AUTO_ASSIGNMENT_ENABLED=false

# Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="cbe.system.user@gmail.com"
SMTP_PASS="your-email-password-here"
MAIL_FROM="cbe.system.user@gmail.com"

# CouchDB Configuration
# All four are required; the service fails to start if any is missing.
COUCHDB_URL=http://couchdb:5984
COUCHDB_DATABASE=cms-evidence
COUCHDB_USERNAME=
COUCHDB_PASSWORD=

# Session cookie flags - required; the service fails to start if either is missing.
# secure=true requires HTTPS end-to-end; set false only for local HTTP dev.
# sameSite=strict is safest, but the Voila iframe needs 'none' (with secure=true)
# when the frontend and backend are on different registrable domains.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict

# CORS - comma-separated list of allowed browser origins. Required.
# Exact origins only (scheme + host + port), no trailing slash, no wildcards.
# 5175 is the vite dev server (frontend/vite.config.ts); 5173 is the port the
# frontend container publishes (docker-compose-cms.yml). Both are listed so
# local dev works either way - trim this to the real origin in deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5173,http://127.0.0.1:5173

# Audit-lib OpenSearch Configuration
AUDIT_PROVIDER=opensearch
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false
OPENSEARCH_REFRESH=false

# Tazama Authentication (RSA Public Key)
TAZAMA_AUTH_URL=http://10.10.80.30:3020/v1/auth
AUTH_PUBLIC_KEY_PATH=public.pem
CERT_PATH_PUBLIC=public.pem

# Voila Proxy Configuration
VOILA_BASE_URL=http://voila:8866

# Gold Lakehouse API
# GOLD_LAKEHOUSE_API_URL=http://gold-lakehouse:8000
GOLD_LAKEHOUSE_API_URL=http://10.10.80.19:8282
GOLD_LAKEHOUSE_TIMEOUT=30000

# Investigation copilot and SAR/STR drafting (backlog P4-2, P3-2)
# COPILOT_MODE: bundled (open-weight model shipped with the CMS, data stays in the deployment),
#               byok (your own OpenAI-compatible endpoint and key; case data is sent there), or off
# Two independent features, each on only when exactly "true" (otherwise its routes 404 and the UI hides it):
#   COPILOT_INVESTIGATION_ENABLED  investigation copilot: summary, red flags, next steps and the case chat
#   COPILOT_SAR_ENABLED            SAR/STR drafting and its maker-checker review (drafts from the investigation record)
COPILOT_INVESTIGATION_ENABLED=false
COPILOT_SAR_ENABLED=false
# COPILOT_STRATEGY: pipeline (default; the model reads all facts in one prompt) or agent (it chooses facts to read with
# read-only tools, within these limits). The agent needs a model with tool calling (llama.cpp --jinja, or a provider).
# COPILOT_STRATEGY=pipeline
# COPILOT_AGENT_MAX_STEPS=6
# COPILOT_AGENT_MAX_TOOL_CALLS=8
# COPILOT_AGENT_TIMEOUT_MS=240000
# COPILOT_MEANING_CHECK: true adds a second model reading of each cited sentence against its facts and removes those
# whose facts do not say it (catches meaning errors the number and name checks cannot). One more model call per text.
# COPILOT_MEANING_CHECK=false
COPILOT_MODE=bundled
COPILOT_BUNDLED_URL=http://copilot-llm:8091/v1
COPILOT_BUNDLED_MODEL=qwen3-4b-instruct-2507
COPILOT_BUNDLED_LICENSE=Apache-2.0
# COPILOT_BYOK_URL=https://api.openai.com/v1
# COPILOT_BYOK_API_KEY=
# COPILOT_BYOK_MODEL=
# COPILOT_EMBEDDINGS=builtin
# COPILOT_REPORTING_FSP=fsp001
# COPILOT_CTR_THRESHOLD=2000000
# GOAML_RENTITY_ID=
